{
  "name": "@bharatbite/foods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generated/*": "./generated/*"
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog": "node scripts/generate-catalog.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/__tests__/*.test.js\""
  },
  "dependencies": {
    "@bharatbite/core": "*"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3"
  }
}
